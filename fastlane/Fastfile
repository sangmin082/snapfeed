default_platform(:ios)

GIT_URL = "https://github.com/sangmin082/snapfeed.git"
# v1 branch holds a cert that was revoked on the portal (2026-07-05); a fresh
# storage branch lets match mint & store a new one without deleting anything.
GIT_BRANCH = "match-certs-v2"

def asc_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false
  )
end

platform :ios do
  desc "One-time: revoke existing distribution certs/profiles and reset match storage"
  lane :certs_nuke do
    match_nuke(
      type: "appstore",
      api_key: asc_key,
      git_url: GIT_URL,
      git_branch: GIT_BRANCH,
      skip_confirmation: true
    )
  end

  desc "Build and upload to TestFlight using match + App Store Connect API key"
  lane :beta do
    setup_ci
    api_key = asc_key

    # Reuse a stored distribution cert + App Store profile (creates them on the
    # first run and commits them, encrypted, to the match-certs branch). This
    # avoids re-minting a new certificate on every CI run.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: ENV["BUNDLE_ID"],
      git_url: GIT_URL,
      git_branch: GIT_BRANCH,
      readonly: false,
      # Regenerate the profile each run so newly enabled App ID capabilities
      # (associated domains, Sign in with Apple) are always included.
      force: true
    )
    profile_name = ENV["sigh_#{ENV['BUNDLE_ID']}_appstore_profile-name"]

    # NOTE: the App Store Connect app record must be created once in the web UI
    # (My Apps → New App, bundle id com.snapfeed.com). Apple's API key cannot
    # create new app records, so we don't attempt it here.

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["TEAM_ID"],
      bundle_identifier: ENV["BUNDLE_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV["RUNNER_TEMP"],
      # TARGETED_DEVICE_FAMILY=1 → iPhone-only; drops the iPad-screenshot
      # requirement at submission (the UI is phone-first anyway).
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']} CODE_SIGN_ENTITLEMENTS=App/App.entitlements TARGETED_DEVICE_FAMILY=1",
      export_options: {
        provisioningProfiles: { ENV["BUNDLE_ID"] => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV["BUNDLE_ID"],
      skip_waiting_for_build_processing: true
    )
  end
end
