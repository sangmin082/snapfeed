default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight using App Store Connect API key"
  lane :beta do
    # Dedicated, unlocked keychain so `cert` can import the distribution key
    # without a UI password prompt.
    keychain_name = "build.keychain"
    keychain_password = "ci-temp-pass"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    delete_keychain(name: keychain_name) if File.exist?(keychain_path)
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )

    # Create / download an Apple Distribution certificate and an App Store
    # provisioning profile via the API key. No registered devices required
    # (that requirement only applies to *development* profiles).
    cert(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )
    sigh(api_key: api_key, app_identifier: ENV["BUNDLE_ID"])

    # Switch the Capacitor project to manual distribution signing with the
    # profile we just created.
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["TEAM_ID"],
      bundle_identifier: ENV["BUNDLE_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV["RUNNER_TEMP"],
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}",
      export_options: {
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
