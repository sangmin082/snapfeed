# Copy to .env.local (gitignored). In production these live as Cloudflare Pages Secrets.

# --- Gemini (does OCR + structuring in one multimodal call) ---
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Store packaging (optional; see docs/store-submission.md) ---
# Play Store TWA: serves /.well-known/assetlinks.json when both are set.
# Fingerprints are comma-separated SHA-256 signing-cert fingerprints
# (Play App Signing cert, plus your local/upload cert for testing).
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# App Store (iOS wrapper): serves /.well-known/apple-app-site-association.
# Format: <TEAM_ID>.<BUNDLE_ID>, e.g. ABCDE12345.app.snapfeed.ios
APPLE_APP_ID=
