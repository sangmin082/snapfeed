# Copy to .env.local (gitignored). In production these live as Cloudflare Pages Secrets.

# --- Gemini (does OCR + structuring in one multimodal call) ---
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
