# Copy to .env.local (gitignored). In production these live as Cloudflare Pages Secrets.

# --- Google Cloud Vision ---
# Paste the entire service-account JSON on a single line (escape inner newlines in the
# `private_key` field as \n). Cloudflare Pages secrets accept the raw multi-line form.
GCP_SA_KEY_JSON=

# --- Anthropic (Claude Haiku for OCR-text structuring) ---
ANTHROPIC_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
